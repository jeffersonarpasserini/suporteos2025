# Copie este arquivo para .env e ajuste os valores para sua maquina.
# O arquivo .env real nao deve ser enviado para o Git.

SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/cursodb
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# JWT: use uma chave aleatoria com pelo menos 32 caracteres.
# Exemplo para gerar: openssl rand -base64 32
JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_EXPIRATION=60m
JWT_ISSUER=suporteos2025

# Primeiro usuario administrador criado ao iniciar o perfil dev
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=troque-esta-senha-do-administrador

# Variaveis utilizadas pelo Docker Compose
POSTGRES_DB=cursodb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
APP_PORT=8080
